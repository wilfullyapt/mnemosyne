# Copy to a secret store or local .env — never commit real passwords.
# Expected production DB name: mnemosyne
# Expected roles (Lamassu): mnemosyne_migrator, mnemosyne_ingest, mnemosyne_app, mnemosyne_ro

# Migrator / admin apply:
# DATABASE_URL=postgresql://mnemosyne_migrator@HOST:5432/mnemosyne

# Ingest worker:
# DATABASE_URL=postgresql://mnemosyne_ingest@HOST:5432/mnemosyne

# App / review tools:
# DATABASE_URL=postgresql://mnemosyne_app@HOST:5432/mnemosyne

# Read-only recall (optional):
# DATABASE_URL=postgresql://mnemosyne_ro@HOST:5432/mnemosyne

DATABASE_URL=postgresql://mnemosyne:CHANGE_ME@127.0.0.1:5432/mnemosyne

# Optional CI alias:
# TEST_DATABASE_URL=postgresql://mnemosyne:mnemosyne@localhost:5432/mnemosyne_test
